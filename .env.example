# Cashmere Agent SDK - Environment Variables
# Copy this file to .env and fill in your values
#
# IMPORTANT: Never commit .env to version control

# EVM private key (hex, with or without 0x prefix, as MetaMask exports it)
EVM_PRIVATE_KEY=

# Solana private key (base58 as Phantom or Solflare export it, solana-keygen JSON array, or hex)
SOLANA_PRIVATE_KEY=

# Aptos private key (hex, with or without 0x prefix, or ed25519-priv-0x... as Petra exports it)
# Supports both 32-byte (64 hex) and 64-byte (128 hex, private+public) formats
APTOS_PRIVATE_KEY=

# Sui private key (suiprivkey1... as Slush, Sui Wallet or `sui keytool export` give it, or hex with or without 0x prefix)
SUI_PRIVATE_KEY=

# Optional: Custom RPC URLs (defaults to public RPCs if not set)
# EVM_RPC_URL=
# SOLANA_RPC_URL=
# APTOS_RPC_URL=
# SUI_RPC_URL=

# Gas API URL
GAS_API_URL=https://gas.cashmere.exchange

# MCP server only (npx -y @cashmerelabs/cashmere-agent-sdk@0.4.0). The MCP client config passes these, and the server
# reads only CASHMERE_ names, so the keys above are never picked up from your shell:
# CASHMERE_EVM_PRIVATE_KEY=, CASHMERE_SOLANA_PRIVATE_KEY=, CASHMERE_APTOS_PRIVATE_KEY=, CASHMERE_SUI_PRIVATE_KEY=
# CASHMERE_EVM_RPC_URL=, CASHMERE_SOLANA_RPC_URL=, CASHMERE_APTOS_RPC_URL=, CASHMERE_SUI_RPC_URL=, CASHMERE_GAS_API_URL=
# CASHMERE_MCP_READ_ONLY=1             # read tools only: cashmere_bridge and the Goat LP write tools are off, keys not read
# CASHMERE_MCP_MAX_AMOUNT=500          # largest USDC amount per transfer
# CASHMERE_MCP_MAX_TOTAL=2000          # largest USDC total while the server runs
# CASHMERE_MCP_ALLOWED_RECIPIENTS=     # comma-separated recipients; empty allows any
# npm_config_ignore_scripts=true       # npx then runs no dependency install scripts with your keys around
#
# Goat LP on Robinhood Chain (MCP server; the write tools sign with CASHMERE_EVM_PRIVATE_KEY):
# CASHMERE_ROBINHOOD_RPC_URL=          # https only; default https://rpc.mainnet.chain.robinhood.com
# CASHMERE_GOATLP_MAX_DEPOSIT_USD=100  # largest USD value of one goatlp_add_liquidity call
# CASHMERE_GOATLP_MAX_TOTAL_USD=500    # largest USD value goatlp_add_liquidity deposits while the server runs
