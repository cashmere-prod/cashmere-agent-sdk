# Cashmere Agent SDK - Environment Variables
# Copy this file to .env and fill in your values
#
# IMPORTANT: Never commit .env to version control

# EVM private key (hex, with or without 0x prefix)
EVM_PRIVATE_KEY=

# Solana private key (base58 or hex format)
SOLANA_PRIVATE_KEY=

# Aptos private key (hex, with or without 0x prefix)
# Supports both 32-byte (64 hex) and 64-byte (128 hex, private+public) formats
APTOS_PRIVATE_KEY=

# Sui private key (hex, with or without 0x prefix)
SUI_PRIVATE_KEY=

# Optional: Custom RPC URLs (defaults to public RPCs if not set)
# EVM_RPC_URL=
# SOLANA_RPC_URL=
# APTOS_RPC_URL=
# SUI_RPC_URL=

# Gas API URL
GAS_API_URL=https://gas.cashmere.exchange

# MCP server only (npx -y @cashmerelabs/cashmere-agent-sdk); the MCP client config passes these
# CASHMERE_MCP_READ_ONLY=1      # quotes and routes only: cashmere_bridge is off and the keys are not read
# CASHMERE_MCP_MAX_AMOUNT=500   # largest USDC amount per transfer
